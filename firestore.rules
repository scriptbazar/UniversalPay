rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow any authenticated user to read the list of users.
    // This is for the admin panel to function correctly.
    // Writes are restricted to prevent users from modifying each other's data.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }
  }
}
