
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is an admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection rules
    match /users/{userId} {
      // Admins can get any user profile
      // Authenticated users can get their own profile
      allow get: if isAdmin() || isOwner(userId);
      
      // Only Admins can list the users collection
      allow list: if isAdmin();
      
      // An authenticated user can update their own profile
      // An admin can update any user profile
      allow update: if isOwner(userId) || isAdmin();
      
      // Users are created via Cloud Function, so no direct client creation.
      // Admins can delete users.
      allow create: if false;
      allow delete: if isAdmin();
    }

    // Audit Logs: Only admins can read/write.
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
    
    // Transactions: Admins can see all, merchants can see their own.
    match /transactions/{transactionId} {
       allow get: if isAdmin() || isOwner(resource.data.merchantId);
       allow list: if isAuthenticated(); // List allowed, but query must be secured client-side
       allow create: if isAuthenticated(); // Any auth'd user can create (e.g., a customer paying)
       allow update, delete: if isAdmin(); // Only admin can modify
    }
    
    // Tickets: Admins can access all, merchants their own.
    match /tickets/{ticketId} {
       allow get: if isAdmin() || isOwner(resource.data.merchantId);
       allow list: if isAuthenticated(); // List allowed, query secured client-side
       allow create: if isAuthenticated(); // Merchant can create their own ticket
       allow update: if isAdmin() || isOwner(resource.data.merchantId); // Merchant or admin can update (e.g., add reply)
       allow delete: if isAdmin();
    }
    
    // Withdrawals: Admins can access all, merchants their own.
    match /withdrawals/{withdrawalId} {
       allow get: if isAdmin() || isOwner(resource.data.merchantId);
       allow list: if isAuthenticated(); // List allowed, query secured client-side
       allow create: if isOwner(request.resource.data.merchantId); // Merchant can create their own request
       allow update, delete: if isAdmin();
    }

    // Payment Links: Admins can access all, merchants their own.
    match /paymentLinks/{linkId} {
       allow get: if isAdmin() || isOwner(resource.data.merchantId);
       allow list: if isAuthenticated(); // List allowed, query secured client-side
       allow create: if isOwner(request.resource.data.merchantId); // Merchant creates their own
       allow update: if isAdmin() || isOwner(resource.data.merchantId);
       allow delete: if isAdmin() || isOwner(resource.data.merchantId);
    }
    
    // Invoices: Admins can access all, merchants their own.
    match /invoices/{invoiceId} {
       allow get: if isAdmin() || isOwner(resource.data.merchantId);
       allow list: if isAuthenticated(); // List allowed, query secured client-side
       allow create: if isOwner(request.resource.data.merchantId);
       allow update: if isAdmin() || isOwner(resource.data.merchantId);
       allow delete: if isAdmin() || isOwner(resource.data.merchantId);
    }
  }
}

    