rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admins can read the entire 'users' collection.
    match /users/{userId} {
      allow list: if request.auth.token.role == 'admin';
      allow get, update: if request.auth.uid == userId || request.auth.token.role == 'admin';
      allow create: if request.auth.token.role == 'admin';
    }

    // Allow admins to manage settings
    match /settings/{docId} {
      allow read, write: if request.auth.token.role == 'admin';
    }

  }
}
