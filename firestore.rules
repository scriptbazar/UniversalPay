rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to make rules cleaner
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isNewOwner(userId) {
        return request.auth.uid == userId && request.resource.data.merchantId == userId;
    }
    
    function isOwnerOfExistingDoc(collectionName, docId, fieldName) {
        return get(/databases/$(database)/documents/$(collectionName)/$(docId))[fieldName] == request.auth.uid;
    }

    // Admins have full access to everything
    match /{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Users collection rules
    match /users/{userId} {
      allow read, create: if isOwner(userId);
      // Users can update their own profile, but cannot change their role, status, or balance.
      allow update: if isOwner(userId) && !(request.resource.data.role != resource.data.role) 
                                      && !(request.resource.data.status != resource.data.status)
                                      && !(request.resource.data.walletBalance != resource.data.walletBalance);
    }
    
    // Customers can be read/written by the owner merchant
    match /customers/{customerId} {
        allow read, write: if isOwner(request.resource.data.merchantId);
    }

    // Payment Links can be read by anyone, but only created/modified by their owner
    match /paymentLinks/{linkId} {
        allow read: if true;
        allow create: if isNewOwner(request.resource.data.merchantId);
        allow update, delete: if isOwnerOfExistingDoc('paymentLinks', linkId, 'merchantId');
    }

    // Transactions can only be read/written by the owner merchant
    match /transactions/{transactionId} {
        allow read, write: if isOwner(request.resource.data.merchantId);
    }
    
    // Invoices can only be read/written by the owner merchant
    match /invoices/{invoiceId} {
        allow read, write: if isOwner(request.resource.data.merchantId);
    }

    // Withdrawals can only be read/written by the owner merchant
    match /withdrawals/{withdrawalId} {
        allow read, write: if isOwner(request.resource.data.merchantId);
    }

    // Tickets can only be created and then updated by the owner merchant, admin can update too
    match /tickets/{ticketId} {
      allow create: if isNewOwner(request.resource.data.merchantId);
      // Read and update allowed for owner and admin (admin rule is already global)
      allow read, update: if isOwnerOfExistingDoc('tickets', ticketId, 'merchantId');
    }

    // Notifications can be read by their intended user
    match /notifications/{notificationId} {
        allow read: if isOwner(request.resource.data.userId);
    }

    // Merchants can only submit wallet load requests for themselves
    match /walletLoadRequests/{requestId} {
        allow create: if isNewOwner(request.resource.data.merchantId);
        allow read: if isOwnerOfExistingDoc('walletLoadRequests', requestId, 'merchantId');
    }

    // Publicly readable, but only writable by admins
    match /subscriptionPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Admin-only collections
    match /platform/{docId} {
      allow read, write: if isAdmin();
    }
    
    match /audit_logs/{logId} {
        allow read, write: if isAdmin();
    }
  }
}
