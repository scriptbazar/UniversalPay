rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // USERS:
    // Admins can read/write any user document.
    // Merchants can only read/write their own document.
    match /users/{userId} {
      allow read, write: if isAdmin() || isOwner(userId);
    }

    // TRANSACTIONS:
    // Admins can read all transactions.
    // Merchants can only read their own transactions.
    // No one can update/delete transactions to maintain integrity.
    match /transactions/{transactionId} {
      allow read: if isAdmin() || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'merchant' && resource.data.merchantId == request.auth.uid);
      allow create: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'merchant';
      allow update, delete: if false;
    }

    // PAYMENT LINKS:
    // Admins can read all links.
    // Merchants can read/write their own links.
    match /paymentLinks/{linkId} {
      allow read: if isAdmin() || isOwner(resource.data.merchantId);
      allow write: if isOwner(request.resource.data.merchantId);
    }

    // INVOICES:
    // Admins can read all invoices.
    // Merchants can read/write their own invoices.
    match /invoices/{invoiceId} {
        allow read: if isAdmin() || isOwner(resource.data.merchantId);
        allow write: if isOwner(request.resource.data.merchantId);
    }
    
    // CUSTOMERS:
    // Admins can read all customers.
    // Merchants can read their own customers.
    // Merchants can create customers.
    match /customers/{customerId} {
        allow read: if isAdmin() || isOwner(resource.data.merchantId);
        allow create: if request.auth.uid != null; // Any authenticated user can create a customer record initially
        allow update, delete: if isAdmin() || isOwner(resource.data.merchantId);
    }

    // WITHDRAWALS:
    // Admins can read all withdrawals.
    // Merchants can read/write their own withdrawal requests.
    match /withdrawals/{withdrawalId} {
      allow read: if isAdmin() || isOwner(resource.data.merchantId);
      allow create: if isOwner(request.resource.data.merchantId);
      allow update: if isAdmin(); // Only admins can approve/reject
      allow delete: if false;
    }
    
    // WALLET LOAD REQUESTS:
    // Admins can read/update all requests.
    // Merchants can create/read their own requests.
    match /walletLoadRequests/{requestId} {
       allow read: if isAdmin() || isOwner(resource.data.merchantId);
       allow create: if isOwner(request.resource.data.merchantId);
       allow update: if isAdmin(); // Only admins can approve/reject
       allow delete: if false;
    }
    
    // TICKETS:
    // Admins can read/write all tickets.
    // Merchants can create tickets, and read/update their own tickets.
    match /tickets/{ticketId} {
        allow read, update: if isAdmin() || isOwner(resource.data.merchantId);
        allow create: if request.auth.uid != null;
    }
    
    // AUDIT LOGS:
    // Only backend services/admins should write to audit logs.
    // Admins can read them.
    match /audit_logs/{logId} {
        allow read: if isAdmin();
        allow write: if false; // Should only be written by server/cloud functions
    }
  }
}
