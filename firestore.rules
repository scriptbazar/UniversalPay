rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Rules for the users collection
    match /users/{userId} {

      // Admins can list all documents in the collection.
      allow list: if request.auth.token.role == 'admin';

      // Admins can read any user document.
      // A user can read their own document.
      allow read: if request.auth.token.role == 'admin' || request.auth.uid == userId;
      
      // Admins can update any user document.
      // A user can update their own document.
      // A user can be created.
      allow write: if request.auth.token.role == 'admin' || request.auth.uid == userId;
    }

    // Rules for the audit_logs collection
    match /audit_logs/{logId} {
      // Only admins can read audit logs.
      allow read: if request.auth.token.role == 'admin';
      
      // Audit logs can only be created by the server (Cloud Functions).
      allow write: if false;
    }
  }
}
