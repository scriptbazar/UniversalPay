rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ======== Helper Functions ========
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isMerchant() {
        return request.auth.token.role == 'merchant';
    }

    function isOwnerOfData() {
        return request.auth.uid == request.resource.data.merchantId;
    }

    // ======== User Profiles ========
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      // Users can update their own profile, but cannot change sensitive fields.
      allow update: if isOwner(userId)
                    && request.resource.data.keys().diff(['role', 'status', 'plan', 'kycStatus', 'walletBalance', 'handle', 'handleLastUpdatedAt', 'handleEditCount']).size() > 0;
      // Only admins can create or delete user profiles directly (onCreate is handled by Cloud Function).
      allow create, delete: if isAdmin();
    }
    
    // ======== Platform-Wide Settings (Admin Only) ========
    match /platform/{docId} {
        allow read, write: if isAdmin();
    }
    
    match /subscriptionPlans/{planId} {
        // Anyone can read plans, only admin can modify
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }

    // ======== Data Collections (Merchants manage their own) ========
    match /transactions/{transactionId} {
      // Admin can see all transactions. Merchants can see their own.
      allow read: if isAdmin() || (isMerchant() && get(/databases/$(database)/documents/transactions/$(transactionId)).data.merchantId == request.auth.uid);
      // Transactions are created by the system/payment flows.
      allow write: if isAdmin(); 
    }

    match /paymentLinks/{linkId} {
        // Anyone can read a link to pay, but only owner/admin can see details in dashboard.
        allow get: true;
        allow list, write: if isAdmin() || isOwnerOfData();
        allow update, delete: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
    }
    
    match /customers/{customerId} {
        allow read, write: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
        allow create: if isOwnerOfData();
    }
    
    match /invoices/{invoiceId} {
        allow read, write: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
        allow create: if isOwnerOfData();
    }
    
    match /withdrawals/{withdrawalId} {
        allow read, write: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
        allow create: if isOwnerOfData();
    }
    
    match /tickets/{ticketId} {
        allow read, write: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
        allow create: if isOwnerOfData();
    }
    
     match /walletLoadRequests/{requestId} {
        allow read, write: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
        allow create: if isOwnerOfData();
    }

    // ======== Logging (Admin Read-Only) ========
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Can only be written by Cloud Functions
    }
  }
}
