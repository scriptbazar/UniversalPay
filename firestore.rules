rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to access only their own document
    match /users/{userId} {
      // Admins can read/write any user document
      allow read, write: if request.auth.token.role == 'admin';
      
      // Logged-in users can read, create, update their own document
      allow read, create, update: if request.auth.uid == userId;
      
      // Deletion restricted to admin only
      allow delete: if request.auth.token.role == 'admin';
    }

    // All other documents in any collection (wildcard)
    match /{document=**} {
      // Admins can read/write everything
      allow read, write: if request.auth.token.role == 'admin';
    }
  }
}
