rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Secure rules for the 'users' collection
    match /users/{userId} {
      // Admins can list and get any user
      allow list: if request.auth.token.role == 'admin';
      allow get: if request.auth.token.role == 'admin' || request.auth.uid == userId;
      
      // Users can only update their own document
      allow update: if request.auth.uid == userId;
      
      // Allow user creation for signup
      allow create: if request.auth != null;
    }

    // Rules for transactions
    match /transactions/{transactionId} {
      // Admins can read any transaction
      allow get, list: if request.auth.token.role == 'admin';
      
      // Merchants can read their own transactions
      allow get, list: if request.auth != null && request.auth.uid == resource.data.merchantId;
      
      // Allow creation for authenticated users
      allow create: if request.auth != null;
    }
    
    // Rules for payment links
    match /paymentLinks/{linkId} {
       // Admins can read any link, merchants can read their own
      allow get, list: if request.auth != null && (request.auth.uid == resource.data.merchantId || request.auth.token.role == 'admin');
      // Merchants can create/update/delete their own links
      allow write: if request.auth != null && request.auth.uid == resource.data.merchantId;
    }

    // Rules for invoices
    match /invoices/{invoiceId} {
        allow get, list: if request.auth != null && (request.auth.uid == resource.data.merchantId || request.auth.token.role == 'admin');
        allow write: if request.auth != null && request.auth.uid == resource.data.merchantId;
    }
    
    // Rules for support tickets
    match /tickets/{ticketId} {
      allow get, list, write: if request.auth != null && (request.auth.uid == resource.data.merchantId || request.auth.token.role == 'admin');
    }

    // Rules for audit logs - only admins can read all. Merchants can read their own.
    match /audit_logs/{logId} {
        allow list, get: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.uid == resource.data.details.targetUser);
        // Only backend can create logs
        allow write: if false; 
    }

    // Rules for wallet load requests
    match /walletLoadRequests/{requestId} {
        allow get, list, create: if request.auth != null && request.auth.uid == resource.data.merchantId;
        // Only Admins can update/delete (approve/reject)
        allow update, delete: if request.auth.token.role == 'admin';
    }

    // Rules for withdrawals
    match /withdrawals/{withdrawalId} {
      allow get, list, create: if request.auth != null && request.auth.uid == resource.data.merchantId;
      allow update, delete: if request.auth.token.role == 'admin';
    }
  }
}
