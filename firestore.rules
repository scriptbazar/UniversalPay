rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public read for payment links (slug-based access)
    match /paymentLinks/{linkId} {
      allow get: if true;
      allow list, create, update, delete: if request.auth.token.role == 'admin' || request.auth.uid == resource.data.merchantId;
    }

    // Allow users to be created by anyone, but only admins can list them.
    // Only the user themselves or an admin can read/update a specific user doc.
    match /users/{userId} {
      allow create: if true;
      allow get: if request.auth.uid == userId || request.auth.token.role == 'admin';
      allow list: if request.auth.token.role == 'admin';
      // Only allow user to update their own doc, or an admin to update any doc
      allow update: if request.auth.uid == userId || request.auth.token.role == 'admin';
    }
    
    // Transactions can be created by anyone (public payment pages)
    // Merchants can only list their own transactions. Admins can list all.
    match /transactions/{transactionId} {
      allow create: if true;
      allow get: if request.auth.token.role == 'admin' || resource.data.merchantId == request.auth.uid;
      // This rule allows admins to list all, and merchants to list only their own.
      allow list: if request.auth.token.role == 'admin' || request.auth.uid == resource.data.merchantId;
    }
    
    // Customers can only be read by their merchant or an admin
    match /customers/{customerId} {
      allow read, write: if request.auth.token.role == 'admin' || resource.data.merchantId == request.auth.uid;
    }

    // Notifications can be read by their owner or an admin
    match /notifications/{notificationId} {
      allow read: if request.auth.token.role == 'admin' || resource.data.userId == request.auth.uid;
      allow create: if true;
    }
    
    // Audit logs can only be read by admins
    match /audit_logs/{logId} {
        allow read: if request.auth.token.role == 'admin';
        // Allow server-side code (like Cloud Functions) to create logs
        allow create: if true; 
    }
    
    // Tickets can be created/read by the merchant who owns them, or read/updated by an admin.
    match /tickets/{ticketId} {
      allow read, create, update: if request.auth.token.role == 'admin' || request.auth.uid == resource.data.merchantId;
    }

    // Other collections can be read/written by the merchant who owns them or an admin
    match /invoices/{docId} {
        allow read, write: if request.auth.token.role == 'admin' || resource.data.merchantId == request.auth.uid;
    }

     match /withdrawals/{docId} {
        allow read, write: if request.auth.token.role == 'admin' || resource.data.merchantId == request.auth.uid;
    }
    
     match /walletLoadRequests/{docId} {
        allow read, write: if request.auth.token.role == 'admin' || resource.data.merchantId == request.auth.uid;
    }

  }
}
