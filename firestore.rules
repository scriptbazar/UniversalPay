
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }

    // Rules for USERS collection
    match /users/{userId} {
      allow read; // Admins and merchants can read user profiles
      allow create: if isAuth(); // Any authenticated user can create their own user document
      allow update: if isOwner(userId) || isAdmin(); // Only the user themselves or an admin can update
      allow delete: if isAdmin(); // Only admins can delete users
    }
    
    // Rules for TRANSACTIONS collection
    match /transactions/{transactionId} {
      // A merchant can read their own transactions. An admin can read all.
      allow read: if isOwner(resource.data.merchantId) || isAdmin();
      // Any authenticated user (e.g., a customer making a payment) can create a transaction.
      // Server-side logic should validate this further.
      allow create: if isAuth(); 
      // Generally, transactions shouldn't be updated or deleted from the client.
      allow update, delete: if isAdmin(); 
    }

    // Rules for PAYMENT LINKS collection
    match /paymentLinks/{linkId} {
        // Public can read single documents for payment pages
        allow get: if resource.data.isActive == true;
        // Merchants can read their own links, admins can read all
        allow list: if isOwner(resource.data.merchantId) || isAdmin();
        // Merchants can create/update/delete their own links
        allow create, update, delete: if isOwner(request.resource.data.merchantId);
    }
    
    // Rules for CUSTOMERS collection
    match /customers/{customerId} {
        // A merchant can read their own customers. An admin can read all.
        allow read: if isOwner(resource.data.merchantId) || isAdmin();
        // Transactions can create customers.
        allow create: if isAuth();
        // Only allow updates from the owner or an admin.
        allow update: if isOwner(resource.data.merchantId) || isAdmin();
    }
    
    // Rules for TICKETS collection
    match /tickets/{ticketId} {
        // A merchant can read their own tickets. An admin can read all.
        allow read: if isOwner(resource.data.merchantId) || isAdmin();
        // Merchants can create their own tickets.
        allow create: if isOwner(request.resource.data.merchantId);
        // Merchants and admins can update (e.g., add a reply).
        allow update: if isOwner(resource.data.merchantId) || isAdmin();
    }
    
    // Rules for INVOICES collection
    match /invoices/{invoiceId} {
        // A merchant can read their own invoices. An admin can read all.
        allow read: if isOwner(resource.data.merchantId) || isAdmin();
        // Merchants can create/update their own invoices
        allow create, update, delete: if isOwner(request.resource.data.merchantId);
    }
    
    // Rules for WITHDRAWALS collection
    match /withdrawals/{withdrawalId} {
        // A merchant can read/create their own withdrawals.
        allow read, create: if isOwner(resource.data.merchantId);
        // An admin can read all withdrawals and update their status.
        allow list, update: if isAdmin();
    }
    
    // Rules for WALLET LOAD REQUESTS collection
     match /walletLoadRequests/{requestId} {
        // A merchant can read/create their own requests.
        allow read, create: if isOwner(request.resource.data.merchantId);
        // An admin can read all requests and update their status.
        allow list, update: if isAdmin();
    }

    // Rules for AUDIT LOGS - only backend/admins should write to this
    match /audit_logs/{logId} {
      allow read: if isAdmin(); // Only admins can read logs
      allow write: if false; // No client-side writes
    }
  }
}
