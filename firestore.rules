rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read and write their own documents
    match /users/{userId} {
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow read, delete: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Allow admins to read all audit logs
    match /audit_logs/{logId} {
        allow read: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow create: if true; // Allow anyone to create audit logs
    }

    // Allow admins to handle reseller requests
    match /resellerRequests/{requestId} {
        allow read, write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow create: if request.auth != null;
    }
    
    // Allow merchants to read their own transactions and admins to read all
    match /transactions/{transactionId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (request.auth.uid == resource.data.merchantId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    match /paymentLinks/{linkId} {
        allow read: if true; // Publicly readable for payment pages
        allow create, update, delete: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || request.auth.uid == resource.data.merchantId);
    }
    
    // Tickets can be read by the merchant who created them or an admin
    match /tickets/{ticketId} {
        allow read, update: if request.auth != null && (request.auth.uid == resource.data.merchantId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
        allow create: if request.auth != null;
    }
    
     // Invoices can be read by the merchant who created them or an admin
    match /invoices/{invoiceId} {
        allow read: if request.auth != null && (request.auth.uid == resource.data.merchantId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
        allow create: if request.auth != null;
    }
    
    // Customers can be read by the merchant they belong to or an admin
    match /customers/{customerId} {
        allow read: if request.auth != null && (request.auth.uid == resource.data.merchantId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
        allow create: if request.auth != null;
    }

    match /withdrawals/{withdrawalId} {
        allow read: if request.auth != null && (request.auth.uid == resource.data.merchantId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
        allow create: if request.auth != null;
        allow update: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /walletLoadRequests/{requestId} {
        allow read: if request.auth != null && (request.auth.uid == resource.data.merchantId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
        allow create: if request.auth != null;
        allow update: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

  }
}