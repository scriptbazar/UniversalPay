
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if the requesting user is the owner of the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Admins can read/write any user document
      // A user can read/write their own document
      allow read, write: if isAdmin() || isOwner(userId);
    }

    // Rules for 'paymentLinks' and 'paymentPages'
    match /paymentLinks/{linkId} {
        // Admin can read any link
        // Merchant can read their own links
        allow read: if isAdmin() || (request.auth != null && resource.data.merchantId == request.auth.uid);
        // Authenticated merchant can create links for themselves
        allow create: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
        // Admin can update any link
        // Merchant can update their own links
        allow update: if isAdmin() || (request.auth != null && resource.data.merchantId == request.auth.uid);
        // Merchant can delete their own links
        allow delete: if request.auth != null && resource.data.merchantId == request.auth.uid;
    }
    
    // Rules for 'transactions' collection
    match /transactions/{transactionId} {
        // Admin can read any transaction
        // Merchant can read their own transactions
        allow read: if isAdmin() || (request.auth != null && resource.data.merchantId == request.auth.uid);
        // Anyone can create a transaction (since it's done during payment)
        allow create: if true;
    }

    // Rules for 'customers' collection
    match /customers/{customerId} {
        // Admin can read any customer
        // A merchant can read their own customers
        allow read: if isAdmin() || (request.auth != null && resource.data.merchantId == request.auth.uid);
        // An authenticated user can create a customer record
        allow create: if request.auth != null;
    }

    // Rules for 'invoices' collection
    match /invoices/{invoiceId} {
        // Admin can read any invoice
        // Merchant can read their own invoices
        allow read: if isAdmin() || (request.auth != null && resource.data.merchantId == request.auth.uid);
        // Merchant can create an invoice for themselves
        allow create: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
    }

    // Rules for 'tickets' collection
    match /tickets/{ticketId} {
        // Admin can read any ticket
        // Merchant can read their own tickets
        allow read: if isAdmin() || (request.auth != null && resource.data.merchantId == request.auth.uid);
        // Merchant can create a ticket for themselves
        allow create: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
        // Admin or the owner merchant can update (add replies to) a ticket
        allow update: if isAdmin() || (request.auth != null && resource.data.merchantId == request.auth.uid);
    }

    // Rules for 'withdrawals' collection
    match /withdrawals/{withdrawalId} {
        // Admin can read any withdrawal
        // Merchant can read their own withdrawals
        allow read: if isAdmin() || (request.auth != null && resource.data.merchantId == request.auth.uid);
        // Merchant can create a withdrawal for themselves
        allow create: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
        // Only admin can update (approve/reject) a withdrawal
        allow update: if isAdmin();
    }
    
     // Rules for 'walletLoadRequests' collection
    match /walletLoadRequests/{requestId} {
        // Admin can read any request
        // Merchant can read their own requests
        allow read: if isAdmin() || (request.auth != null && resource.data.merchantId == request.auth.uid);
        // Merchant can create a request for themselves
        allow create: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
        // Only admin can update (approve/reject) a request
        allow update: if isAdmin();
    }
    
    // Rules for the 'audit_logs' collection
    match /audit_logs/{logId} {
      // Admins can read all logs
      // Authenticated merchants can read their own activity logs
      allow read: if isAdmin() || (request.auth != null && resource.data.details.targetUser == request.auth.uid);
      // Only backend services/admins should write to audit logs, so we restrict client creation
      allow write: if isAdmin();
    }
  }
}
