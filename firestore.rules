rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Check for the admin custom claim on the auth token.
      // This is the correct and efficient way to check roles for list queries.
      return request.auth.token.role == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // An admin can list all users.
      allow list: if isAdmin();
      // An admin or the specific user can read/write their own document.
      allow read, write: if isAdmin() || request.auth.uid == userId;
    }

    // Rules for the 'audit_logs' collection
    match /audit_logs/{logId} {
      // Allow creating logs for any authenticated user (e.g., cloud functions).
      allow create: if request.auth != null;

      // An Admin can list/read ALL logs.
      allow list: if isAdmin();
      allow read: if isAdmin() || request.auth.uid == resource.data.details.targetUser;

      // No one else can update or delete logs directly.
      allow update, delete: if false;
    }

    // Rules for 'paymentLinks'
    match /paymentLinks/{linkId} {
        // Only the merchant who owns it or an admin can manage it.
        allow read, write: if isAdmin() || request.auth.uid == resource.data.merchantId;
        // Anyone can create a payment link if they are authenticated.
        allow create: if request.auth != null;
        // Allow public read for payment pages (pay/[slug] route)
        allow get: if true;
    }

    // Rules for 'invoices'
    match /invoices/{invoiceId} {
      // Only the merchant who owns it or an admin can manage it.
      allow read, write: if isAdmin() || request.auth.uid == resource.data.merchantId;
      // Authenticated users can create invoices.
      allow create: if request.auth != null;
    }

    // Rules for 'tickets'
    match /tickets/{ticketId} {
       // Only the merchant who owns it or an admin can read/write.
      allow read, write: if isAdmin() || request.auth.uid == resource.data.merchantId;
      // Authenticated users can create tickets.
      allow create: if request.auth != null;
    }

    // Rules for 'transactions'
    match /transactions/{txId} {
       // Admins can read all. Merchants can read their own.
       allow read: if isAdmin() || request.auth.uid == resource.data.merchantId;
       // Allow creation by authenticated users (e.g., from a payment page).
       allow create: if request.auth != null;
       // Transactions should not be updated or deleted from the client.
       allow update, delete: if false;
    }

    // Rules for 'withdrawals'
    match /withdrawals/{wdId} {
        // Admins can read and list all. Merchants can read their own.
        allow read, list: if isAdmin() || request.auth.uid == resource.data.merchantId;
        // Merchants can create their own withdrawal requests.
        allow create: if request.auth.uid == request.resource.data.merchantId;
        // Only admins can update (approve/reject).
        allow update: if isAdmin();
        allow delete: if false;
    }

    // Rules for 'notifications'
    match /notifications/{notificationId} {
      allow read, list: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.userId);
      // Allow creation by authenticated users (e.g., by cloud functions).
      allow create: if request.auth != null;
      // Notifications should not be updated or deleted by clients.
      allow update, delete: if false;
    }

  }
}
