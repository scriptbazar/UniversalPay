
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow logged-in users to read, create, and write their own user document
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null; // Any authenticated user can create their own user doc
    }
    
    // Admin can read/write any user document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Merchants can only manage their own data.
    // Admins have full access.
    match /paymentLinks/{linkId} {
        allow read, write: if request.auth != null && (request.resource.data.merchantId == request.auth.uid || request.auth.token.role == 'admin');
    }
    
    match /transactions/{transactionId} {
        // Read: Merchants can read their own transactions, Admins can read all.
        allow read: if request.auth != null && (resource.data.merchantId == request.auth.uid || request.auth.token.role == 'admin');
        // Create: Anyone can create a transaction (e.g., a customer paying).
        allow create: if true;
        // Update: Only Admins can update a transaction.
        allow update: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /customers/{customerId} {
        // Read: Admins can read all, Merchants can read their own.
        allow read: if request.auth != null && (resource.data.merchantId == request.auth.uid || request.auth.token.role == 'admin');
        // Write: Only Admins can create/update customer records directly.
        // Customer records are usually created server-side after a transaction.
        allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /withdrawals/{withdrawalId} {
      // Read: Admins can read all, Merchants can read their own.
      allow read: if request.auth != null && (resource.data.merchantId == request.auth.uid || request.auth.token.role == 'admin');
      // Create: Merchants can create their own withdrawal requests.
      allow create: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
      // Update: Only Admins can update status (approve/reject).
      allow update: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    match /invoices/{invoiceId} {
        // Read: Admins can read all, Merchants can read their own.
        allow read: if request.auth != null && (resource.data.merchantId == request.auth.uid || request.auth.token.role == 'admin');
        // Write: Merchants can create/update their own invoices.
        allow write: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
    }
    
     match /tickets/{ticketId} {
      // Read: Admins can read all, Merchants can read their own.
      allow read: if request.auth != null && (resource.data.merchantId == request.auth.uid || request.auth.token.role == 'admin');
      // Create: Merchants can create tickets.
      allow create: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
      // Update: Both Merchant (for their tickets) and Admin can update (e.g., add replies).
      allow update: if request.auth != null && (resource.data.merchantId == request.auth.uid || request.auth.token.role == 'admin');
    }

    match /resellerRequests/{requestId} {
      // Any authenticated user can create a request.
      allow create: if request.auth != null;
      // Only Admins can read or update (approve/reject) requests.
      allow read, update: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /walletLoadRequests/{requestId} {
      // Merchants can create their own requests.
      allow create: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
      // Admins can read all, merchants can read their own.
      allow read: if request.auth != null && (resource.data.merchantId == request.auth.uid || request.auth.token.role == 'admin');
      // Only Admins can update status.
      allow update: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Audit logs are write-only from the backend, and read-only for admins.
    match /audit_logs/{logId} {
        allow read: if request.auth != null && request.auth.token.role == 'admin';
        allow write: if false; // Only backend/Cloud Functions can write.
    }
    
    match /notifications/{notificationId} {
        // Read: Admins can read all, Merchants can read their own.
        allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.role == 'admin');
        // Write: Only backend/Cloud Functions can write.
        allow write: if false;
    }
  }
}
