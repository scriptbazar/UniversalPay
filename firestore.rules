rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if request.auth.uid == request.resource.data.uid;
      allow list, get: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /paymentLinks/{linkId} {
      allow get: if resource.data.isActive == true;
      allow read, create, update, delete: if isOwner(resource.data.merchantId) || isAdmin();
    }

    match /transactions/{transactionId} {
      allow create: if true;
      allow read: if isOwner(resource.data.merchantId) || isAdmin();
    }

    match /customers/{customerId} {
      allow read, create, update: if isOwner(resource.data.merchantId) || isAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow create: if isOwner(request.resource.data.merchantId);
      allow read: if isOwner(resource.data.merchantId) || isAdmin();
    }

    match /invoices/{invoiceId} {
       allow create: if request.auth != null;
       allow read, update: if isOwner(resource.data.merchantId) || isAdmin();
    }
    
    match /tickets/{ticketId} {
      allow create: if request.auth != null;
      allow read, update: if isOwner(resource.data.merchantId) || isAdmin();
    }

    match /audit_logs/{logId} {
        allow read, write: if isAdmin();
        allow read: if request.auth != null && resource.data.details.targetUser == request.auth.uid;
    }

    match /notifications/{notificationId} {
        allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }
    
    match /walletLoadRequests/{requestId} {
        allow create: if isOwner(request.resource.data.merchantId);
        allow read: if isOwner(resource.data.merchantId) || isAdmin();
        allow update: if isAdmin();
    }
    
    match /resellerRequests/{requestId} {
        allow create: if isOwner(request.resource.data.merchantId);
        allow read, update: if isAdmin();
    }

    match /platform/{docId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }
     match /subscriptionPlans/{planId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }
  }
}
