rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rules for the 'users' collection
    match /users/{userId} {
      // LIST: Only admins can list all users.
      allow list: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // GET: Admins can get any user's profile. A user can get their own profile.
      allow get: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // CREATE: Allow user creation for signup. The default role is set by a Cloud Function.
      allow create: if request.auth != null;
      
      // UPDATE: A user can update their own document. Admins can update any.
      allow update: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // DELETE: Only admins can delete users.
      allow delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for collections owned by a merchant
    match /{collection}/{docId} {
      // This rule applies to: transactions, paymentLinks, customers, invoices, withdrawals, etc.
      // Assumes the document has a `merchantId` field.
      allow read, write: if request.auth != null && (
        (request.resource.data.merchantId == request.auth.uid) || // Owner access
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') // Admin access
      );
    }

    // Rules for Audit Logs
    match /audit_logs/{logId} {
      allow create: if true; // Should be restricted to trusted server environments (e.g., Cloud Functions)
      // READ: Admins can read all logs. Merchants can only read logs related to them.
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        resource.data.details.targetUser == request.auth.uid
      );
    }
    
    // Rules for Tickets
    match /tickets/{ticketId} {
        allow read, write: if request.auth != null && (
            request.resource.data.merchantId == request.auth.uid ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }

    // Rules for Wallet Load Requests
    match /walletLoadRequests/{requestId} {
        allow read, write: if request.auth != null && (
            request.resource.data.merchantId == request.auth.uid ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }
  }
}