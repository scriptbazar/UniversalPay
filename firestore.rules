
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is the owner of a document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if the user is an admin
    function isAdmin() {
        return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // USERS collection
    // Users can read their own data. Admins can read any user's data.
    // Users can update their own data, but not change their role or status.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId);
      allow create, delete: if isAdmin(); // Only admins can create/delete user records directly
    }

    // PAYMENT LINKS & PAGES
    // Anyone can read a payment link/page (it's public).
    // Only the owner merchant can create, update, or delete their own links.
    match /paymentLinks/{linkId} {
      allow read: if true;
      allow create, update, delete: if isOwner(resource.data.merchantId);
    }

    // TRANSACTIONS
    // Only the owner merchant or an admin can read transactions.
    // Transactions are created by the system (or a trusted server environment), not directly by clients.
    match /transactions/{transactionId} {
      allow read: if isOwner(resource.data.merchantId) || isAdmin();
      allow create, update, delete: if false; // Should be handled by backend functions
    }
    
    // CUSTOMERS
    // Only the owner merchant or an admin can manage customer data.
    match /customers/{customerId} {
        allow read, write: if isOwner(resource.data.merchantId) || isAdmin();
    }

    // INVOICES
    // Only the owner merchant can manage their invoices.
    match /invoices/{invoiceId} {
        allow read, write: if isOwner(resource.data.merchantId) || isAdmin();
    }
    
    // WITHDRAWALS
    // Only the owner merchant can create/read their withdrawals.
    // Only an admin can update (approve/reject) them.
    match /withdrawals/{withdrawalId} {
        allow read, create: if isOwner(resource.data.merchantId);
        allow update: if isAdmin();
        allow delete: if false;
    }

    // TICKETS
    // The owner merchant can create and view their own tickets.
    // Admins can view any ticket and update them (e.g., reply, change status).
    match /tickets/{ticketId} {
        allow read, update: if isOwner(resource.data.merchantId) || isAdmin();
        allow create: if isAuthenticated();
    }
    
    // WALLET LOAD REQUESTS
    // Merchants can create their own requests.
    // Admins can read and update (approve/reject) all requests.
    match /walletLoadRequests/{requestId} {
        allow create: if isOwner(request.resource.data.merchantId);
        allow read, update: if isOwner(resource.data.merchantId) || isAdmin();
    }

    // AUDIT LOGS
    // Only admins can read audit logs. No one can create them from the client.
    match /audit_logs/{logId} {
        allow read: if isAdmin();
        allow write: if false; // Only backend can write
    }
    
    // NOTIFICATIONS
    // Users can read their own notifications. Admins can read all.
    match /notifications/{notificationId} {
        allow read: if isOwner(resource.data.userId) || isAdmin();
        allow write: if false; // Only backend can write
    }
  }
}
