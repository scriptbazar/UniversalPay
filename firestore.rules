
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Helper function to check if the requesting user is the owner of the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // ANYONE can create their own user document IF the document ID matches their UID.
      // This is crucial for the signup process to work.
      allow create: if isOwner(userId);
      
      // LOGGED-IN users can read their own profile.
      // ADMINS can read any user's profile.
      allow read: if isOwner(userId) || isAdmin();
      
      // LOGGED-IN users can update their own profile.
      // ADMINS can update any user's profile.
      allow update: if isOwner(userId) || isAdmin();
      
      // Only ADMINS can delete users.
      allow delete: if isAdmin();
    }

    // Rules for platform-wide settings (only admins can access)
    match /platform/{docId} {
      allow read, write: if isAdmin();
    }

    // Rules for subscription plans (anyone can read, only admins can modify)
    match /subscriptionPlans/{planId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }

    // Rules for audit logs (only admins can read/write)
    match /audit_logs/{logId} {
        allow read, write: if isAdmin();
    }

    // Rules for merchant-specific data
    match /{collection}/{docId} {
      // This rule applies to: transactions, paymentLinks, customers, invoices, withdrawals, tickets, notifications
      // A merchant can read/write their own documents.
      // An admin can read/write any document.
      allow read, write: if (isOwner(resource.data.merchantId) && request.auth.token.role == 'merchant') || isAdmin();
    }
    
    // Fallback rule: Deny all other access
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
