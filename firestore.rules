rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read and update their own document in the 'users' collection.
    // They cannot create or delete their own user document directly.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
    }

    // Admins with a 'role' of 'admin' in their token can read/write to any user document.
    // This allows admins to manage users from the dashboard.
    match /users/{userId} {
      allow get, list, create, update, delete: if request.auth.token.role == 'admin';
    }

    // Allow any authenticated user to create an audit log.
    // This is useful for logging user actions. In a production app, you might restrict this further.
    match /audit_logs/{logId} {
      allow create: if request.auth != null;
    }

    // Allow admins to read all audit logs.
    match /audit_logs/{logId} {
        allow get, list: if request.auth.token.role == 'admin';
    }
    
    // Default deny all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}