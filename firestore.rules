rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Allow users to read their own data, and admins to read any user's data.
    // Allow any authenticated user to create their own user document (via Cloud Function).
    match /users/{userId} {
      allow read: if request.auth != null && (isOwner(userId) || isAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && (isOwner(userId) || isAdmin());
    }

    // Allow merchants to read their own payment links. Admins can read any.
    match /paymentLinks/{linkId} {
      allow read: if request.auth != null && (resource.data.merchantId == request.auth.uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.merchantId;
      allow delete: if request.auth != null && resource.data.merchantId == request.auth.uid;
    }

    // Allow merchants to read their own customers. Admins can read any.
    match /customers/{customerId} {
      allow read: if request.auth != null && (resource.data.merchantId == request.auth.uid || isAdmin());
      allow create: if request.auth != null; // Created during a transaction
    }
    
    // Allow merchants to read their own transactions
    // Admins can read any transaction
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (resource.data.merchantId == request.auth.uid || isAdmin());
      allow create: if request.auth != null; // Allow any authenticated user to create a transaction (e.g., a customer making a payment)
    }

    // Allow merchants to manage their own support tickets. Admins can access all.
    match /tickets/{ticketId} {
        allow read, update: if request.auth != null && (resource.data.merchantId == request.auth.uid || isAdmin());
        allow create: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
    }

    // Allow merchants to manage their own wallet load requests. Admins can access all.
    match /walletLoadRequests/{requestId} {
      allow read: if request.auth != null && (resource.data.merchantId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
      allow update: if request.auth != null && isAdmin(); // Only admins can approve/reject
    }

    // Allow merchants to manage their own withdrawals. Admins can access all.
    match /withdrawals/{withdrawalId} {
      allow read: if request.auth != null && (resource.data.merchantId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
      allow update: if request.auth != null && isAdmin(); // Only admins can process
    }

    // Allow merchants to manage their own invoices. Admins can access all.
    match /invoices/{invoiceId} {
      allow read: if request.auth != null && (resource.data.merchantId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
    }
    
    // Allow admins to read all audit logs.
    match /audit_logs/{logId} {
        allow read, create: if request.auth != null && isAdmin();
    }
    
    // Allow merchants to read notifications targeted to them. Admins can read all.
    match /notifications/{notificationId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

  }
}
