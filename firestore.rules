
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // By default, deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow users to read their own document, and admins to read any document.
    match /users/{userId} {
      allow get: if request.auth.uid == userId || request.auth.token.role == 'admin';
      allow list: if request.auth.token.role == 'admin';
      allow create: if request.auth.uid == userId; // Allows user to create their own doc on signup
      allow update: if request.auth.uid == userId; // Allows user to update their own profile
    }

    // Payment links can be created by the owning merchant.
    // They can be read by anyone (for the public payment page).
    // They can only be updated/deleted by the owning merchant or an admin.
    match /paymentLinks/{linkId} {
      allow read: if true;
      allow create: if request.auth.uid == request.resource.data.merchantId;
      allow update, delete: if resource.data.merchantId == request.auth.uid || request.auth.token.role == 'admin';
    }

    // Transactions can be created by anyone (for public payments)
    // They can be read by the owning merchant or an admin.
    match /transactions/{transactionId} {
        allow create: if true;
        allow read: if resource.data.merchantId == request.auth.uid || request.auth.token.role == 'admin';
    }
    
    // Customers can be read by the owning merchant or an admin.
    match /customers/{customerId} {
        allow read: if resource.data.merchantId == request.auth.uid || request.auth.token.role == 'admin';
    }

    // Invoices can be read/managed by the owning merchant or an admin.
    match /invoices/{invoiceId} {
        allow read, create, update, delete: if resource.data.merchantId == request.auth.uid || request.auth.token.role == 'admin';
    }

    // Tickets can be read/managed by the owning merchant or an admin.
    match /tickets/{ticketId} {
        allow read, create, update: if resource.data.merchantId == request.auth.uid || request.auth.token.role == 'admin';
    }
    
    // Withdrawals can be read/managed by the owning merchant or an admin.
    match /withdrawals/{withdrawalId} {
        allow read, create: if request.auth.uid == request.resource.data.merchantId;
        allow update: if request.auth.token.role == 'admin';
    }
    
    // Wallet Load Requests can be managed by the owning merchant or an admin.
     match /walletLoadRequests/{requestId} {
        allow read, create: if request.auth.uid == request.resource.data.merchantId;
        allow update: if request.auth.token.role == 'admin';
    }

    // Audit logs are write-only for authenticated users, and read-only for admins.
    match /audit_logs/{logId} {
      allow read: if request.auth.token.role == 'admin';
      allow create: if request.auth != null;
    }
  }
}
