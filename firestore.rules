rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }
    function isMerchant() {
      return request.auth.token.role == 'merchant';
    }
    function isVerifiedOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Rules for platform-level settings, admin only
    match /platform/{docId} {
      allow read, write: if isAdmin();
    }

    // Rules for subscription plans, admin can manage, merchants can read
    match /subscriptionPlans/{planId} {
        allow read: if isMerchant() || isAdmin();
        allow create, update, delete: if isAdmin();
    }

    // Rules for wallet load requests, merchants can create, admins can read/update
    match /walletLoadRequests/{requestId} {
        allow read, update: if isAdmin();
        allow create: if isOwner(request.resource.data.merchantId);
    }
    
    // Rules for users collection
    match /users/{userId} {
      allow read: if true;
      allow update: if isVerifiedOwner(userId) || isAdmin();
      allow create, delete: if isAdmin();
    }

    // Rules for audit logs - only admins can access
    match /audit_logs/{logId} {
        allow read, write: if isAdmin();
    }

    // Rules for payment links
    match /paymentLinks/{linkId} {
        allow read: if true;
        allow create: if isOwner(request.resource.data.merchantId) || isAdmin();
        allow update, delete: if isOwner(resource.data.merchantId) || isAdmin();
    }

    // Rules for customer data - tied to a merchant
    match /customers/{customerId} {
        allow read, write: if isOwner(resource.data.merchantId) || isAdmin();
    }

    // Rules for invoices - tied to a merchant
    match /invoices/{invoiceId} {
        allow read, write: if isOwner(resource.data.merchantId) || isAdmin();
    }
    
    // Rules for tickets - tied to a merchant
    match /tickets/{ticketId} {
        allow read, create, update: if isOwner(request.resource.data.merchantId) || isAdmin();
        allow delete: if isAdmin();
    }

    // Rules for withdrawals - tied to a merchant
    match /withdrawals/{withdrawalId} {
        allow read, create: if isOwner(request.resource.data.merchantId) || isAdmin();
        allow update, delete: if isAdmin();
    }
    
    // Rules for transactions - tied to a merchant
    match /transactions/{transactionId} {
        allow read: if isOwner(resource.data.merchantId) || isAdmin();
        allow create: if true; // Anyone can create a transaction (e.g., a customer)
        allow update, delete: if isAdmin();
    }

    // Rules for notifications
    match /notifications/{notificationId} {
        allow read, write: if isAdmin(); // Only admins can create/manage notifications
    }
  }
}
