rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // USERS:
    // - Admins can read/write any user.
    // - Authenticated users can read their own data.
    // - Authenticated users can only write to their own document.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // TRANSACTIONS:
    // - Admins can read any transaction.
    // - Authenticated users can read their own transactions.
    // - Only backend services (or authenticated users for their own actions) can create/update.
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.merchantId);
      allow create, update: if request.auth != null; 
      allow delete: if isAdmin();
    }

    // CUSTOMERS:
    // - Admins can read/write any customer.
    // - Authenticated merchants can read/write their own customers.
    match /customers/{customerId} {
      allow read, write: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.merchantId);
    }
    
    // PAYMENT LINKS and PAGES:
    // - Admins can read/write any link/page.
    // - Authenticated merchants can read/write their own links/pages.
    match /paymentLinks/{linkId} {
       allow read, write: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.merchantId);
    }

    // INVOICES:
    // - Admins can read/write any invoice.
    // - Authenticated merchants can read/write their own invoices.
     match /invoices/{invoiceId} {
       allow read, write: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.merchantId);
    }

    // TICKETS:
    // - Admins can read/write any ticket.
    // - Authenticated merchants can read/write their own tickets.
    match /tickets/{ticketId} {
       allow read, write: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.merchantId);
    }
    
    // WITHDRAWALS:
    // - Admins can read/write any withdrawal request.
    // - Authenticated merchants can read/write their own withdrawal requests.
    match /withdrawals/{withdrawalId} {
       allow read, write: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.merchantId);
    }

    // NOTIFICATIONS:
    // - Admins can read all notifications.
    // - Authenticated merchants can read their own notifications.
    // - Only backend services can create notifications.
    match /notifications/{notificationId} {
       allow read: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.userId);
       allow write: if isAdmin(); // Only admins/backend can create notifications
    }

    // RESELLER REQUESTS (Secure even if UI is removed)
    match /resellerRequests/{requestId} {
       allow read: if request.auth != null && isAdmin();
       allow create: if request.auth != null;
       allow update, delete: if request.auth != null && isAdmin();
    }
    
    // WALLET LOAD REQUESTS
    match /walletLoadRequests/{requestId} {
        allow read: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.merchantId);
        allow create: if request.auth != null; // Merchant creates their own
        allow update: if request.auth != null && isAdmin(); // Only admin can approve/reject
    }

    // PLATFORM SETTINGS:
    // - Only accessible by admins.
    match /platform_settings/global {
      allow read, write: if request.auth != null && isAdmin();
    }

    // AUDIT LOGS:
    // - Only readable by admins.
    // - Only writable by backend services (Cloud Functions).
    match /audit_logs/{logId} {
      allow read: if request.auth != null && isAdmin();
      allow write: if request.auth != null; // Allow backend functions to write
    }
  }
}
