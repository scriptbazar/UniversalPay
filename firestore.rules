
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }
  
    match /users/{userId} {
      allow get: if request.auth.uid == userId || isAdmin();
      allow list: if isAdmin();
      allow create;
      allow update: if request.auth.uid == userId || isAdmin();
    }
    
    match /audit_logs/{logId} {
      allow create: if request.auth != null;

      // Allow listing logs only for admins OR for a user querying their own logs.
      // This is crucial for the "My Activity" page for merchants.
      allow list: if isAdmin() || (request.query.where.details.targetUser is string && request.query.where.details.targetUser == request.auth.uid);

      // Allow getting a single log if the user is an admin OR it's their own log.
      allow get: if isAdmin() || request.auth.uid == resource.data.details.targetUser;
    }
  }
}
