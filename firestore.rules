rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow any authenticated user to read the list of users.
    // This is a temporary measure to unblock the user.
    // In a production app, this should be restricted to admins.
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /users/{userId}/{documents=**} {
       allow read, write: if request.auth != null;
    }

    // Fallback for any other collections - restrict to admin for safety
    match /{document=**} {
      allow read, write: if request.auth.token.role == 'admin';
    }
  }
}
