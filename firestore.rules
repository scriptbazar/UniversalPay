
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to keep rules clean
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    function isMerchant() {
      return request.auth.token.role == 'merchant';
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isNewUser() {
      // Allow creation if the user is creating their own document.
      return request.auth.uid == resource.data.uid;
    }

    // ===== USERS =====
    // Admins can read/write any user.
    // Merchants can only read/update their own profile.
    match /users/{userId} {
      allow read, update: isAdmin() || isOwner(userId);
      // Allow a user to create their own document upon signup.
      allow create: isNewUser();
    }

    // ===== PLATFORM SETTINGS =====
    // Only accessible by admins.
    match /platform/settings {
      allow read, write: isAdmin();
    }
    
    // ===== SUBSCRIPTION PLANS =====
    // Admins can manage plans.
    // Merchants can only read them.
    match /subscriptionPlans/{planId} {
      allow read: isMerchant() || isAdmin();
      allow write: isAdmin();
    }

    // ===== AUDIT LOGS =====
    // Admins can read all logs.
    // Merchants can only read logs related to them.
    // All authenticated services can create logs.
    match /audit_logs/{logId} {
      allow create: request.auth != null;
      allow read: isAdmin() || (isMerchant() && resource.data.details.targetUser == request.auth.uid);
    }
    
    // ===== TRANSACTIONS =====
    // Admins can read all transactions.
    // Merchants can only read their own transactions.
    // Transactions can be created by authenticated users (e.g., via payment pages).
    match /transactions/{transactionId} {
        allow create: request.auth != null;
        allow read: isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
    }

    // ===== PAYMENT LINKS / PAGES =====
    // Admins can read all.
    // Merchants can manage their own.
    // Public can read specific pages via slug for payment.
    match /paymentLinks/{linkId} {
      allow read: isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid) || get(/databases/$(database)/documents/paymentLinks/$(linkId)).data.isActive == true;
      allow create, update, delete: isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
    }
    
    // ===== CUSTOMERS =====
    // Admins can read all.
    // Merchants can only manage their own customers.
    match /customers/{customerId} {
       allow create: request.auth != null;
       allow read, update: isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
    }

    // ===== WITHDRAWALS =====
    // Admins can read all.
    // Merchants can create and read their own.
    match /withdrawals/{withdrawalId} {
      allow create: isMerchant();
      allow read: isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
      allow update: isAdmin(); // Only admins can approve/reject
    }
    
    // ===== INVOICES =====
    // Admins can read all.
    // Merchants can create and read their own.
    match /invoices/{invoiceId} {
      allow create: isMerchant();
      allow read, update: isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
    }

    // ===== TICKETS =====
    // Admins can read/update all tickets.
    // Merchants can create tickets and read/update their own.
    match /tickets/{ticketId} {
      allow create: isMerchant();
      allow read, update: isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
    }
    
    // ===== NOTIFICATIONS =====
    // Admins and services can create.
    // Users can read their own notifications.
     match /notifications/{notificationId} {
      allow create: request.auth != null;
      allow read: isAdmin() || (isMerchant() && resource.data.userId == request.auth.uid);
    }

    // ===== RESELLER REQUESTS & WALLET LOADS =====
    // Merchants can create requests.
    // Admins can read and process them.
    match /resellerRequests/{requestId} {
      allow create: isMerchant();
      allow read, update, delete: isAdmin();
    }

    match /walletLoadRequests/{requestId} {
      allow create: isMerchant();
      allow read, update, delete: isAdmin();
    }
  }
}
