rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // A newly authenticated user can create their own user document.
      allow create: if request.auth.uid == userId;
      
      // An existing user can only get or update their own document.
      allow get, update: if request.auth.uid == userId;
      
      // An admin can read the entire list of users or any specific user document.
      allow read: if request.auth.token.role == 'admin';
    }
  }
}
