rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Admins can perform any action on any user document.
      allow read, write: if isAdmin();
      // Merchants can read and update their own document.
      allow get, update: if isOwner(userId);
    }
    
    // Admins can list all users, necessary for the dashboard's user management page.
     match /users/{document=**} {
      allow list: if isAdmin();
    }

    // Rules for the 'transactions' collection
    match /transactions/{transactionId} {
      // Admins can read any transaction.
      allow get, list: if isAdmin();
      // Merchants can read their own transactions. A read rule combines get and list.
      allow read: if isOwner(get(/databases/$(database)/documents/transactions/$(transactionId)).data.merchantId);
      // No one can create/update/delete transactions directly from the client for security.
      allow create, update, delete: if false;
    }
    
    // Rules for 'customers' collection
    match /customers/{customerId} {
      // Admins can read any customer.
      allow get, list: if isAdmin();
      // Merchants can read their own customers.
      allow read: if isOwner(get(/databases/$(database)/documents/customers/$(customerId)).data.merchantId);
      // No one can create/update/delete from the client. This is handled by backend functions.
       allow create, update, delete: if false;
    }

    // Rules for 'paymentLinks' and 'paymentPages'
    match /paymentLinks/{linkId} {
        // Admins can manage all links.
        allow read, write: if isAdmin();
        // Merchants can manage their own links.
        allow read, create, update, delete: if isOwner(resource.data.merchantId);
    }

    // Rules for 'invoices' collection
    match /invoices/{invoiceId} {
      // Admins can read any invoice.
      allow get, list: if isAdmin();
      // Merchants can read their own invoices.
      allow read: if isOwner(get(/databases/$(database)/documents/invoices/$(invoiceId)).data.merchantId);
      // Invoices are created by backend functions, not clients.
      allow create, update, delete: if false;
    }

    // Rules for 'tickets' collection
    match /tickets/{ticketId} {
        allow read, write: if isAdmin(); // Admins have full access
        allow create: if request.auth != null; // Any authenticated user can create a ticket
        allow read, update: if isOwner(resource.data.merchantId); // Merchants can read/update their own tickets
    }
    
    // Rules for 'withdrawals' collection
    match /withdrawals/{withdrawalId} {
        allow read, update: if isAdmin(); // Admins can read and update (approve/reject)
        allow create, list, get: if isOwner(resource.data.merchantId); // Merchants can create and read their own
    }
    
    // Rules for 'notifications' collection
    match /notifications/{notificationId} {
        allow read: if isAdmin() || isOwner(resource.data.userId);
        // Notifications are created by backend functions only.
        allow create, update, delete: if false;
    }

    // Rules for audit logs - only accessible by admins
    match /audit_logs/{logId} {
      allow read, list: if isAdmin();
      allow write: if false; // Logs are only created by backend functions
    }
    
    // Rules for platform settings - only accessible by admins
    match /platform_settings/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
