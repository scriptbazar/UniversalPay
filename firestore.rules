
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Admins can list all users.
      // An admin or the user themselves can get a single user document.
      allow list: if request.auth.token.role == 'admin';
      allow get: if request.auth.token.role == 'admin' || request.auth.uid == userId;
      // Only a user can update their own document. Admins must use a cloud function.
      allow update: if request.auth.uid == userId;
      // Allow anyone to create a user document (for signup).
      allow create: if true;
    }

    match /audit_logs/{logId} {
        // Admins can read all logs.
        allow list: if request.auth.token.role == 'admin';
        // Allow creating logs (server-side only with proper auth).
        allow create: if true;
        // Allow a user to read their own activity logs (if stored here)
        allow get: if request.auth.token.role == 'admin' || request.auth.uid == resource.data.details.targetUser;
    }
    
    match /activity_logs/{logId} {
        // Merchants can only read their own activity logs.
        allow list, get: if request.auth.uid == resource.data.userId;
        // Allow creating logs (server-side only with proper auth).
        allow create: if true;
    }

    match /transactions/{transactionId} {
      // Admins can list all transactions.
      // Merchants can list their own transactions.
      allow list: if request.auth.token.role == 'admin' || request.auth.uid == request.query.where.merchantId;
      
      // An admin or the transaction's merchant can get a single document.
      allow get: if request.auth.token.role == 'admin' || request.auth.uid == resource.data.merchantId;
      
      // Allow creating transactions (e.g., from a server-side process).
      allow create: if true;
    }

    match /paymentLinks/{linkId} {
        // An admin or the link's owner can read it.
        allow get, list: if request.auth.token.role == 'admin' || request.auth.uid == resource.data.merchantId;
        // A merchant can create and update their own links.
        allow create, update: if request.auth.uid == request.resource.data.merchantId;
        // A merchant can delete their own links.
        allow delete: if request.auth.token.role == 'admin' || request.auth.uid == resource.data.merchantId;
    }

    match /invoices/{invoiceId} {
        // An admin or the invoice's owner can read it.
        allow get, list: if request.auth.token.role == 'admin' || request.auth.uid == resource.data.merchantId;
         // A merchant can create and update their own invoices.
        allow create, update: if request.auth.uid == request.resource.data.merchantId;
    }
    
    match /customers/{customerId} {
      // Admins or the associated merchant can read customer data.
      allow get, list: if request.auth.token.role == 'admin' || request.auth.uid == resource.data.merchantId;
    }

    match /tickets/{ticketId} {
        // Admin or the ticket owner can read.
        allow get, list: if request.auth.token.role == 'admin' || request.auth.uid == resource.data.merchantId;
        // A merchant can create a ticket.
        allow create, update: if request.auth.uid == request.resource.data.merchantId;
    }
    
     match /walletLoadRequests/{requestId} {
        // Admin or the request owner can read.
        allow get, list: if request.auth.token.role == 'admin' || request.auth.uid == resource.data.merchantId;
        // A merchant can create a request.
        allow create: if request.auth.uid == request.resource.data.merchantId;
        // Only an admin can update (approve/reject).
        allow update: if request.auth.token.role == 'admin';
    }

     match /withdrawals/{withdrawalId} {
        // Admin or the request owner can read.
        allow get, list: if request.auth.token.role == 'admin' || request.auth.uid == resource.data.merchantId;
        // A merchant can create a request.
        allow create: if request.auth.uid == request.resource.data.merchantId;
        // Only an admin can update (approve/reject).
        allow update: if request.auth.token.role == 'admin';
    }
  }
}
