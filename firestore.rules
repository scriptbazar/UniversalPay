
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper functions
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isMerchant() {
        return request.auth.token.role == 'merchant';
    }

    // Users Collection
    // - Admins can read/write any user document.
    // - Authenticated users can read their own document.
    // - Authenticated users can update their own document, but not change role/status.
    // - Users can create their own document (handled by cloud function on signup).
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) && !('role' in request.resource.data) && !('status' in request.resource.data));
      allow delete: if isAdmin();
    }

    // Transactions Collection
    // - Admins can read any transaction.
    // - Merchants can read their own transactions.
    // - Public can create transactions (e.g., via a payment page).
    match /transactions/{transactionId} {
      allow read: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
      allow create: if request.auth != null; // Allow any authenticated entity (client or server) to create
      allow update, delete: if isAdmin();
    }

    // Customers Collection
    // - Admins can read any customer.
    // - Merchants can read their own customers.
    // - Transactions can create new customers.
    match /customers/{customerId} {
      allow read: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
      allow create: if request.auth != null; // Let the transaction function create it
      allow update, delete: if isAdmin();
    }

    // PaymentLinks Collection
    // - Public can read active links/pages.
    // - Merchants can create/read/update their own links/pages.
    // - Admins can manage all links/pages.
    match /paymentLinks/{linkId} {
      allow read: if resource.data.isActive == true || isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
      allow create: if isMerchant();
      allow update: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
      allow delete: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
    }
    
    // Invoices Collection
    // - Merchants can read their own invoices.
    // - Admins can read all invoices.
    // - Transactions can create invoices.
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Tickets Collection
    // - Admins can read/update all tickets.
    // - Merchants can create tickets and read/update their own tickets.
    match /tickets/{ticketId} {
      allow read, update: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
      allow create: if isMerchant();
      allow delete: if isAdmin();
    }

    // Withdrawals Collection
    // - Admins can read/update all withdrawal requests.
    // - Merchants can create and read their own withdrawal requests.
    match /withdrawals/{withdrawalId} {
      allow read: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
      allow create: if isMerchant();
      allow update, delete: if isAdmin();
    }

    // Notifications Collection
    // - Admins can read all notifications.
    // - Merchants can read their own notifications.
    // - Server (admin) can create notifications.
    match /notifications/{notificationId} {
       allow read: if isAdmin() || (isMerchant() && resource.data.userId == request.auth.uid);
       allow create, update, delete: if isAdmin(); // Only admin/server can create notifications
    }
    
    // Audit Logs Collection
    // - Only admins can read audit logs.
    // - Only the server (authenticated with admin privileges) can write logs.
    match /audit_logs/{logId} {
      allow read, write, create, delete: if isAdmin();
    }
    
    // Platform Settings Collection
    // - Only admins can read and write platform settings.
    match /platform_settings/{docId} {
       allow read, write, create, delete: if isAdmin();
    }
    
    // KYC Documents Collection
    // - Admins can read all KYC documents.
    // - Users can only create/read their own KYC documents.
    match /kyc_documents/{docId} {
        allow read, update: if isAdmin() || (isOwner(resource.data.userId));
        allow create: if isOwner(request.resource.data.userId);
        allow delete: if isAdmin();
    }
    
    // Reseller Requests Collection
    // - Admin can manage all.
    // - Merchants can create their own request.
    match /resellerRequests/{requestId} {
        allow read, update, delete: if isAdmin();
        allow create: if isMerchant();
    }
    
     // Wallet Load Requests Collection
    // - Admins can manage all.
    // - Merchants can create and read their own.
    match /walletLoadRequests/{requestId} {
        allow read: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
        allow create: if isMerchant();
        allow update, delete: if isAdmin();
    }
  }
}
