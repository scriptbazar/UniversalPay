rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }
    function isMerchant() {
      return request.auth.token.role == 'merchant';
    }
    function isSignedIn() {
      return request.auth != null;
    }

    // Collection Rules
    match /users/{userId} {
      // Admins can see and edit any user.
      // Merchants can see and edit their own profile.
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();
    }

    match /transactions/{transactionId} {
      // Admins can see any transaction.
      // Merchants can only see their own transactions.
      allow get: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
      allow list: if isAdmin() || isMerchant(); // Merchants list is filtered by rules
      allow create: if isSignedIn(); // Anyone signed in can create a transaction (e.g. via payment page)
      allow update, delete: if isAdmin(); // Only admins can modify or delete transactions
    }

    match /customers/{customerId} {
      // Admins can see any customer.
      // Merchants can see their own customers.
      allow get: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
      allow list: if isAdmin() || isMerchant();
      allow create, update, delete: if isAdmin() || isMerchant(); // Merchants can manage their customers
    }
    
    match /paymentLinks/{linkId} {
      // Admins can see any payment link.
      // Merchants can manage their own payment links.
      allow get, list: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
      allow create, update, delete: if isAdmin() || (isMerchant() && request.resource.data.merchantId == request.auth.uid);
    }
    
    match /tickets/{ticketId} {
      allow get, list: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
      allow create, update: if isSignedIn(); // Any signed-in user (merchant) can create/update their tickets.
    }
    
    match /withdrawals/{withdrawalId} {
      allow get, list: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
      allow create: if isMerchant(); // Merchants can create withdrawal requests
      allow update: if isAdmin(); // Only admins can approve/reject withdrawals
    }
    
    match /invoices/{invoiceId} {
      allow get, list: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
      allow create: if isMerchant();
      allow update: if isMerchant() && resource.data.merchantId == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    match /notifications/{notificationId} {
        // Admins see all, merchants see their own
        allow get, list: if isAdmin() || (isMerchant() && resource.data.userId == request.auth.uid);
        allow create, update, delete: if isAdmin(); // Only admins can manage notifications
    }
    
    match /audit_logs/{logId} {
      // Only admins can access audit logs.
      allow read, list, create, update, delete: if isAdmin();
    }

    match /platform_settings/global {
        allow read: if isSignedIn(); // All signed in users can read settings
        allow write: if isAdmin(); // Only admins can change platform settings
    }
    
    match /resellerRequests/{requestId} {
      allow read, list, create, update: if isSignedIn(); // Merchants can request, admins can approve/reject
      allow delete: if isAdmin();
    }
    
    match /walletLoadRequests/{requestId} {
       allow get, list: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
       allow create: if isMerchant();
       allow update: if isAdmin();
    }
  }
}

    