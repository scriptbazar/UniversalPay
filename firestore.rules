rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection rules
    match /users/{userId} {
      // Admins can read any user profile
      allow read: if request.auth.token.role == 'admin';
      // An authenticated user can read their own profile
      allow read: if request.auth.uid == userId;

      // An authenticated user can update their own profile,
      // but they cannot change their role or status.
      allow update: if request.auth.uid == userId
                    && !('role' in request.resource.data)
                    && !('status' in request.resource.data);
    }

    // Transactions collection rules
    match /transactions/{txId} {
      // Admins can read any transaction
      allow read: if request.auth.token.role == 'admin';
      // Merchants can only read their own transactions
      allow read: if request.auth.uid == resource.data.merchantId;
      // Clients/Customers can create transactions
      allow create: if true;
    }
    
    // Payment Links collection rules
    match /paymentLinks/{linkId} {
      // Anyone can read a payment link to make a payment
      allow read: if true;
      // Admins can read/write any link
      allow read, write: if request.auth.token.role == 'admin';
      // Merchants can create links and read/update/delete their own
      allow create, update, delete: if request.auth.uid == request.resource.data.merchantId;
      allow read: if request.auth.uid == resource.data.merchantId;
    }

    // Tickets collection rules
    match /tickets/{ticketId} {
      // Admins can read/write any ticket
      allow read, write: if request.auth.token.role == 'admin';
      // Merchants can create tickets and read/update their own
      allow create: if request.auth.uid == request.resource.data.merchantId;
      allow read, update: if request.auth.uid == resource.data.merchantId;
    }

    // Withdrawals collection rules
    match /withdrawals/{withdrawalId} {
        // Admins can read/write any withdrawal request
        allow read, write: if request.auth.token.role == 'admin';
        // Merchants can create withdrawals and read their own
        allow create: if request.auth.uid == request.resource.data.merchantId;
        allow read: if request.auth.uid == resource.data.merchantId;
    }
    
    // Audit Logs can only be read by admins
    match /audit_logs/{logId} {
      allow read: if request.auth.token.role == 'admin';
      // Writes to audit logs should only be done by server-side Cloud Functions
      allow write: if false; 
    }
  }
}
