rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow users to read/update their own document
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;

      // Allow admins to read/list all user documents
      allow get, list: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Allow admins to read the audit logs collection
    match /audit_logs/{logId} {
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      // Writes are only allowed from the backend (Cloud Functions)
      allow write: if false;
    }
  }
}
