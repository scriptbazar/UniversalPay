rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // ANY authenticated user can CREATE their OWN user document.
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Users can READ their own document. Admins can read any document.
      allow read: if request.auth.uid == userId || isAdmin();
      
      // Users can UPDATE their own document. Admins can update any document.
      allow update: if request.auth.uid == userId || isAdmin();
      
      // Only Admins can DELETE a user document.
      allow delete: if isAdmin();
    }
    
    // Rules for all other collections
    match /{document=**} {
       // Admins can read and write to any other document.
       // Logged-in users can read documents (e.g., for subscription plans, etc.)
       allow read: if request.auth != null;
       
       // Default deny for writes unless overridden by more specific rules below.
       allow write: if isAdmin();
    }

    // Rules for merchant-specific data, ensuring only the owner or an admin can access it.
    match /paymentLinks/{linkId} {
      allow read: if request.auth != null; // Publicly readable for payment pages
      allow write: if resource.data.merchantId == request.auth.uid || isAdmin();
    }
    
    match /transactions/{transactionId} {
        allow read, write: if resource.data.merchantId == request.auth.uid || isAdmin();
    }

    match /customers/{customerId} {
        allow read, write: if resource.data.merchantId == request.auth.uid || isAdmin();
    }

    match /withdrawals/{withdrawalId} {
        allow read, create: if request.auth.uid == request.resource.data.merchantId;
        allow update, delete: if isAdmin();
    }
    
    match /invoices/{invoiceId} {
        allow read, write: if resource.data.merchantId == request.auth.uid || isAdmin();
    }

    match /tickets/{ticketId} {
       allow read, create: if request.auth != null;
       allow update: if request.auth.uid == resource.data.merchantId || isAdmin();
    }

    // Platform settings should only be managed by admins
    match /platform/{setting} {
      allow read, write: if isAdmin();
    }

    // Subscription plans can be read by any authenticated user, but only managed by admins.
    match /subscriptionPlans/{planId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Audit logs can only be created by backend services (or admins), and read only by admins.
    match /audit_logs/{logId} {
        allow read: if isAdmin();
        allow create: if request.auth != null; // Allow server-side functions and admins to write
    }
  }
}
