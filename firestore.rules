rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users Collection
    match /users/{userId} {
      // Admins can read any user profile.
      // Authenticated users can read their own profile.
      allow read: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
                  || request.auth.uid == userId;

      // Only the user themselves or an admin can update their profile.
      // Prevent users from changing their own role or status.
      allow update: if (request.auth.uid == userId && !("role" in request.resource.data) && !("status" in request.resource.data))
                    || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      // Allow users to be created.
      allow create: if request.auth.uid != null;
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      // Admins can read any transaction.
      // Merchants can read their own transactions.
      allow get: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
                 || resource.data.merchantId == request.auth.uid;
      
      // Allow authenticated users to query the collection.
      // Security is enforced by the queries in the application code.
      allow list: if request.auth != null;

      // Allow authenticated users to create transactions.
      allow create: if request.auth != null;
    }

    // Tickets Collection
    match /tickets/{ticketId} {
      // Admins can read/update any ticket.
      // Merchants can read/update their own tickets.
      allow get, update: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
                         || resource.data.merchantId == request.auth.uid;

      // Allow authenticated users to query the collection.
      allow list: if request.auth != null;
      
      // Allow authenticated users to create tickets for themselves.
      allow create: if request.auth.uid == request.resource.data.merchantId;
    }

    // Withdrawals Collection
    match /withdrawals/{withdrawalId} {
       // Admins can read/update any withdrawal.
      // Merchants can read their own withdrawals.
       allow get, update: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
                         || resource.data.merchantId == request.auth.uid;

      // Allow authenticated users to query the collection.
      allow list: if request.auth != null;

      // Allow authenticated users to create withdrawal requests for themselves.
      allow create: if request.auth.uid == request.resource.data.merchantId;
    }

    // Payment Links Collection
    match /paymentLinks/{linkId} {
      // Admins can read/update any link.
      // Merchants can read/update their own links.
      allow read, update: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
                         || resource.data.merchantId == request.auth.uid;

      // Allow authenticated users to create links for themselves.
      allow create: if request.auth.uid == request.resource.data.merchantId;
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      // Only admins can read audit logs.
      allow read: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // No one can create/update/delete from the client. This is handled by Cloud Functions.
      allow write: if false;
    }
  }
}
