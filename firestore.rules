rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /users/{userId} {
      // Admins can read any user document. Users can only read their own.
      allow get: if request.auth.token.role == 'admin' || request.auth.uid == userId;
      
      // Admins can list all users.
      allow list: if request.auth.token.role == 'admin';
      
      // Users can update their own profile. Admins can update any profile.
      allow write: if request.auth.token.role == 'admin' || request.auth.uid == userId;
    }

    // Admins can read audit logs.
    match /audit_logs/{logId} {
        allow read: if request.auth.token.role == 'admin';
        // Only backend can create/update/delete logs.
        allow write: if false; 
    }
  }
}
