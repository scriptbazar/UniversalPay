
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to the users collection for any authenticated user.
    // This is necessary for the client-side user list fetching.
    // Write access is restricted to the user themselves to update their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny all other collections for now.
    // Add rules for other collections as needed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
