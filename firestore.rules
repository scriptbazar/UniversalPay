rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Admins can read/write all data. This rule is essential for the Admin Dashboard to function correctly.
    match /{document=**} {
      function isAdmin() {
        return request.auth != null && request.auth.token.role == 'admin';
      }
      allow read, write: if isAdmin();
    }

    // Users collection:
    // - Any authenticated user can create their own user document (on signup).
    // - A user can only read or update their own document.
    match /users/{userId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && request.auth.uid == userId;
      // Deletion is a sensitive operation, restricted to admins for now.
      allow delete: if isAdmin();
    }

    // Merchants can manage their own related data.
    match /paymentLinks/{linkId} {
      allow read, write: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
    }
    
    match /transactions/{transactionId} {
      allow read, write: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
    }

    match /customers/{customerId} {
      allow read, write: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
    }
    
    match /invoices/{invoiceId} {
        allow read, write: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
    }
    
    match /tickets/{ticketId} {
        allow read, write: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
    }
    
    match /withdrawals/{withdrawalId} {
      allow read, write: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
    }

    match /walletLoadRequests/{requestId} {
      allow read, write: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
    }
    
    // Reseller requests can be created by any authenticated user, but only read by admins.
    match /resellerRequests/{requestId} {
        allow create: if request.auth != null;
        allow read: if isAdmin();
        // Updates are handled by a secure Cloud Function.
        allow update: if isAdmin(); 
    }
    
    // Audit logs can only be created by server-side logic (Cloud Functions) and read by admins.
    // No client should be able to write or delete them.
    match /audit_logs/{logId} {
        allow read: if isAdmin();
        // Writes should ideally only come from trusted server environments (Cloud Functions),
        // but we allow admins for now if needed for direct actions. No client deletion.
        allow write: if isAdmin();
        allow delete: if false; // Nobody can delete audit logs from the client.
    }
    
     // Notifications can be read by the user they are intended for.
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
