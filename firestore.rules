
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Grant admins read access (get, list) to the entire users collection.
    // Grant non-admins access only to their own document.
    match /users/{userId} {
      allow read: if request.auth.token.role == 'admin';
      allow get, update: if request.auth.uid == userId;
    }
  }
}
