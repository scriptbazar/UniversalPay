rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admins can read/write all user documents.
    // Authenticated users can read/update their own document.
    // Any authenticated user can create their own user document upon signup.
    match /users/{userId} {
      allow read, update: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');
      allow create: if request.auth != null;
      allow list, write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Only admins can read audit logs. Writes are handled by backend functions with admin privileges.
    match /audit_logs/{logId} {
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      allow write: if false; // Prevent client-side writes
    }
  }
}