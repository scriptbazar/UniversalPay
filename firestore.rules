rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles
    match /users/{userId} {
      // Admins can read/write any user document
      allow read, write: if request.auth.token.role == 'admin';
      // Authenticated users can read their own document
      allow get: if request.auth.uid == userId;
      // Authenticated users can update their own document, but not change role/status
      allow update: if request.auth.uid == userId && !('role' in request.resource.data) && !('status'in request.resource.data);
    }
    
    // Transactions
    match /transactions/{transactionId} {
      // Admins can read any transaction
      allow read: if request.auth.token.role == 'admin';
      // Merchants can read their own transactions
      allow get, list: if request.auth.uid == resource.data.merchantId;
      // Anyone can create a transaction (e.g., via a payment page)
      allow create: if true;
    }
    
    // Customers
    match /customers/{customerId} {
      // Admins can read any customer
      allow read: if request.auth.token.role == 'admin';
      // Merchants can read their own customers
      allow get, list: if request.auth.uid == resource.data.merchantId;
      // Transactions function can create/update customers
      allow write: if true;
    }

    // Payment Links & Pages
    match /paymentLinks/{linkId} {
        // Admins can manage all links/pages
        allow read, write: if request.auth.token.role == 'admin';
        // Merchants can manage their own links/pages
        allow get, list, create, update, delete: if request.auth.uid == resource.data.merchantId;
        // Public can read a single link/page to pay
        allow get: if request.auth == null || request.auth.uid != null;
    }

    // Audit Logs (Only readable by admins)
    match /audit_logs/{logId} {
        allow read: if request.auth.token.role == 'admin';
        // Deny all client-side writes; logs should be created by Cloud Functions
        allow write: if false; 
    }
    
    // Invoices
    match /invoices/{invoiceId} {
        allow read: if request.auth.token.role == 'admin' || request.auth.uid == resource.data.merchantId;
        allow create, update: if request.auth.uid == resource.data.merchantId;
    }
    
    // Support Tickets
    match /tickets/{ticketId} {
        allow read, update: if request.auth.token.role == 'admin' || request.auth.uid == resource.data.merchantId;
        allow create: if request.auth.uid != null;
    }

    // Withdrawals
    match /withdrawals/{withdrawalId} {
        // Admins can read/update any withdrawal
        allow read, update: if request.auth.token.role == 'admin';
        // Merchants can read/create their own withdrawals
        allow get, list, create: if request.auth.uid == resource.data.merchantId;
    }

    // Platform Settings (Admin only)
    match /platform_settings/{docId} {
        allow read, write: if request.auth.token.role == 'admin';
    }
    
    // Notifications
    match /notifications/{notificationId} {
        // Admins can see all notifications. Merchants can only see theirs.
        allow read: if request.auth.token.role == 'admin' || request.auth.uid == resource.data.userId;
    }
    
    // Wallet Load Requests
    match /walletLoadRequests/{requestId} {
        // Merchants can create and read their own requests
        allow create, get, list: if request.auth.uid == request.resource.data.merchantId;
        // Admins can read and update any request
        allow read, update: if request.auth.token.role == 'admin';
    }
    
    // Reseller Requests
    match /resellerRequests/{requestId} {
        // Admins and merchants can create/read requests
        allow read, create: if request.auth.uid != null;
        // Only admins can update (approve/reject)
        allow update: if request.auth.token.role == 'admin';
    }
  }
}
