rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow users to read and write their own data
    match /users/{userId} {
      allow read, update, delete: if request.auth.uid == userId;
      allow create: if request.auth.uid != null;
    }

    // Allow admins to manage all users
    match /users/{userId} {
        allow read, write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Allow merchants to create payment links
    match /paymentLinks/{linkId} {
        allow read;
        allow create, update, delete: if request.auth.uid == request.resource.data.merchantId;
    }

    // Allow admins to read all payment links
    match /paymentLinks/{linkId} {
        allow read, write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Rules for audit logs
    match /audit_logs/{logId} {
      allow read, write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Allow merchants to read their own activity logs
    match /audit_logs/{logId} {
        allow read: if request.auth.uid == resource.data.details.targetUser;
    }

    // Allow anyone to create a transaction (payment page is public)
    match /transactions/{txId} {
        allow create: if true;
    }
    
    // Allow merchants to read their own transactions
    match /transactions/{txId} {
        allow read: if request.auth.uid == resource.data.merchantId;
    }
    
    // Allow admins to read all transactions
     match /transactions/{txId} {
        allow read: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Rules for invoices
    match /invoices/{invoiceId} {
        allow create: if request.auth.uid != null;
        allow read: if request.auth.uid == resource.data.merchantId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Rules for tickets
    match /tickets/{ticketId} {
        allow read, create, update: if request.auth.uid == resource.data.merchantId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Rules for wallet load requests
    match /walletLoadRequests/{reqId} {
        allow create: if request.auth.uid != null;
        allow read: if request.auth.uid == resource.data.merchantId;
        allow read, update: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for customer data
    match /customers/{customerId} {
      allow read: if request.auth.uid == resource.data.merchantId;
      allow read: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Rules for withdrawals
    match /withdrawals/{withdrawalId} {
      allow create: if request.auth.uid == request.resource.data.merchantId;
      allow read: if request.auth.uid == resource.data.merchantId;
      allow read, update: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
