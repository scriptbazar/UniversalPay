
rules_version = '2';

// By default, deny all reads and writes
// This is a good security practice.
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Allow admins to read/write anything for administrative purposes
    // This is a broad permission, use with caution.
    match /{document=**} {
      allow read, write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // USERS COLLECTION
    // Users can read their own profile.
    // Users can update their own profile, but cannot change their role or status.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
                    && !('role' in request.resource.data)
                    && !('status' in request.resource.data)
                    && !('kycStatus' in request.resource.data);
    }
    
    // TRANSACTIONS COLLECTION
    // Merchants can read their own transactions.
    // Transactions can only be created by an authenticated user (via server-side logic).
    match /transactions/{transactionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.merchantId;
      allow create: if request.auth != null;
    }
    
    // CUSTOMERS COLLECTION
    // Merchants can read their own customers.
    // Customers are created/updated on the server when a transaction is made.
    match /customers/{customerId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.merchantId;
      allow create, update: if request.auth != null; // Allow server-side creation
    }

    // PAYMENT LINKS COLLECTION
    // Merchants can read and manage their own payment links.
    match /paymentLinks/{linkId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == resource.data.merchantId;
    }

    // INVOICES COLLECTION
    // Merchants can read and manage their own invoices.
    match /invoices/{invoiceId} {
      allow read, create, update: if request.auth != null && request.auth.uid == resource.data.merchantId;
    }
    
    // TICKETS COLLECTION
    // Merchants can read and manage their own support tickets.
    match /tickets/{ticketId} {
      allow read, create, update: if request.auth != null && request.auth.uid == resource.data.merchantId;
    }

    // WITHDRAWALS COLLECTION
    // Merchants can read and create their own withdrawal requests.
    // Only admins can update (approve/reject) them.
    match /withdrawals/{withdrawalId} {
      allow read, create: if request.auth != null && request.auth.uid == resource.data.merchantId;
      // Update rule handled by the admin-level rule at the top.
    }
    
    // WALLET LOAD REQUESTS COLLECTION
    // Merchants can create and read their own requests.
    // Only admins can update them.
    match /walletLoadRequests/{requestId} {
      allow read, create: if request.auth != null && request.auth.uid == resource.data.merchantId;
       // Update rule handled by the admin-level rule at the top.
    }

    // AUDIT LOGS COLLECTION
    // No client should be able to read or write these directly.
    // They are created and read by backend functions/admins only.
    match /audit_logs/{logId} {
      allow read, write: if false;
    }
    
    // NOTIFICATIONS COLLECTION
    // Users can read their own notifications.
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
     // PLATFORM SETTINGS COLLECTION
    // Only admins should be able to read/write this.
    // This is handled by the global admin rule at the top.
    match /platform_settings/{docId} {
       // Read/write is handled by the global admin rule.
       // Deny for all other users.
       allow read, write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
