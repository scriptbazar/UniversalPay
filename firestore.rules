rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role using custom claims
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow list: if isAdmin();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // Rules for the 'audit_logs' collection
    match /audit_logs/{logId} {
      // Admins can create, read, and list all logs.
      allow read, list, create: if isAdmin();

      // Authenticated merchants can read logs pertaining to them.
      allow read: if request.auth.uid == resource.data.details.targetUser;

      // This is a more specific rule for the list/query operation on the merchant side.
      // It ensures a merchant can only query for their own logs.
      allow list: if isAdmin() || (request.auth.uid != null && request.query.where.size() > 0 && request.query.where[0][0] == 'details.targetUser' && request.query.where[0][2] == request.auth.uid);
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
