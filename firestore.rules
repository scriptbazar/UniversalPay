rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // A user can read and update their own document.
      allow read, update: if request.auth != null && request.auth.uid == userId;
      
      // Any authenticated user can create their own user document during signup.
      allow create: if request.auth != null;

      // An admin can read or write any specific user's document.
      allow get, write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{document=**} {
        // Admins are allowed to list all documents in the 'users' collection.
        allow list: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
