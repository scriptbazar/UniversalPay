rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users can read their own profile, admins can read any
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId);
      // Create is handled by Cloud Function
      allow create, delete: if isAdmin(); 
    }
    
    // Platform-wide settings can only be managed by admins
    match /platform/{docId} {
      allow read, write: if isAdmin();
    }
    
    // Subscription plans are public to read, but only admins can modify them
    match /subscriptionPlans/{planId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Merchants can only manage their own customers
    match /customers/{customerId} {
      allow read, write: if request.auth != null && resource.data.merchantId == request.auth.uid;
      allow create: if request.auth != null;
      // Only admins can delete customers
      allow delete: if isAdmin();
    }

    // Merchants can only manage their own transactions
    match /transactions/{transactionId} {
      allow read, write: if request.auth != null && resource.data.merchantId == request.auth.uid;
      allow create: if true; // Public payment pages need to create transactions
      // Only admins can delete transactions
      allow delete: if isAdmin();
    }
    
    // Merchants can only manage their own payment links/pages
    match /paymentLinks/{linkId} {
      allow read: if request.auth != null && resource.data.merchantId == request.auth.uid || isAdmin();
      allow create, update, delete: if request.auth != null && resource.data.merchantId == request.auth.uid || isAdmin();
    }
    
    // Merchants can only manage their own invoices
    match /invoices/{invoiceId} {
      allow read, write: if request.auth != null && resource.data.merchantId == request.auth.uid;
      allow create: if request.auth != null;
      allow delete: if isAdmin();
    }
    
    // Merchants can only manage their own support tickets
    match /tickets/{ticketId} {
      allow read, update: if request.auth != null && (resource.data.merchantId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow delete: if isAdmin();
    }
    
    // Merchants can only manage their own withdrawal requests
    match /withdrawals/{withdrawalId} {
       allow read: if request.auth != null && (resource.data.merchantId == request.auth.uid || isAdmin());
       allow create: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
       allow update: if isAdmin(); // Only admins can approve/reject
       allow delete: if isAdmin();
    }
    
    // Wallet load requests can be created/read by the merchant, updated by admin
    match /walletLoadRequests/{requestId} {
        allow read: if request.auth != null && (resource.data.merchantId == request.auth.uid || isAdmin());
        allow create: if request.auth != null && request.resource.data.merchantId == request.auth.uid;
        allow update: if isAdmin();
        allow delete: if isAdmin();
    }

    // Admins can read all audit logs. Merchants can read their own.
    match /audit_logs/{logId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.details.targetUser == request.auth.uid);
      allow write: if true; // Writable by backend functions
    }
    
     // Notifications can be read by their target user or admins
    match /notifications/{notificationId} {
        allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
        allow write: if true; // Writable by backend functions
    }

    // Reseller requests can be created by merchants, but only read/updated by admins
    match /resellerRequests/{requestId} {
        allow create: if request.auth != null;
        allow read, update, delete: if isAdmin();
    }
  }
}
